{
  "name": "mytol-workspace",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "myTOL — phylogenetic tree viewer. Headless core + canvas renderer + React binding + standalone app.",
  "workspaces": [
    "packages/core",
    "packages/renderer",
    "packages/react",
    "packages/app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace packages/app"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
